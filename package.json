{
  "name": "tc-message-service",
  "version": "1.1.2",
  "description": "Topcoder platform messaging service",
  "main": "app/index.js",
  "engines": {
    "node": ">=8.2.1"
  },
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/appirio-tech/tc-message-service.git"
  },
  "keywords": [
    "Topcoder",
    "messaging"
  ],
  "author": "Mauricio Desiderio",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/appirio-tech/tc-message-service/issues"
  },
  "homepage": "https://github.com/appirio-tech/tc-message-service#readme",
  "scripts": {
    "lint": "./node_modules/.bin/eslint .",
    "lint:fix": "./node_modules/.bin/eslint . --fix || true",
    "db:reset": "env-cmd node scripts/init-db.js",
    "data:export": "env-cmd node scripts/exportData.js",
    "data:import": "env-cmd node scripts/importData.js",
    "local:init": "npm run db:reset -- --force && npm run data:import -- --force",
    "services:up": "docker-compose -f ./local/docker-compose.yml --env-file .env up -d",
    "services:down": "docker-compose -f ./local/docker-compose.yml down",
    "services:logs": "docker-compose -f ./local/docker-compose.yml logs",
    "migrate": "env-cmd sequelize db:migrate",
    "migrate:undo": "env-cmd sequelize db:migrate:undo",
    "clean-attachments": "env-cmd node ./scripts/cleanPostAttachments.js",
    "start": "node app/index.js",
    "start:dev": "NODE_ENV=local PORT=8001 env-cmd nodemon app/index.js",
    "test": "npm run lint && LOG_LEVEL=debug NODE_ENV=test TC_MESSAGE_SERVICE_AUTH_LOOSE=true env-cmd --verbose --silent istanbul cover -x '*.spec.js' _mocha -- --timeout 5000 $(find app -path '*.spec.js')",
    "test:watch": "NODE_ENV=test env-cmd --verbose --silent mocha $(find app -name '*.spec.js')"
  },
  "dependencies": {
    "aws-sdk": "^2.200.0",
    "axios": "^0.16.1",
    "bluebird": "^3.4.1",
    "body-parser": "^1.15.2",
    "common-errors": "^1.0.0",
    "compression": "^1.7.3",
    "config": "^1.21.0",
    "cookie-parser": "~1.3.5",
    "cors": "^2.8.3",
    "elasticsearch": "^15.0.0",
    "express": "^4.14.0",
    "express-formidable": "^1.0.0",
    "express-list-routes": "^0.1.4",
    "express-request-id": "^1.1.0",
    "expression-evaluator": "git+https://github.com/topcoder-platform/expression-evaluator.git#dev",
    "http-aws-es": "^6.0.0",
    "joi": "^8.0.5",
    "jsonwebtoken": "^7.1.9",
    "lodash": "~4.13.1",
    "moment": "^2.24.0",
    "pg": "^6.0.2",
    "sequelize": "^4.13.5",
    "tc-core-library-js": "appirio-tech/tc-core-library-js.git#v2.6.3",
    "uuid": "^3.2.1"
  },
  "devDependencies": {
    "chai": "^3.5.0",
    "env-cmd": "^10.1.0",
    "eslint": "^3.16.1",
    "eslint-config-airbnb-base": "^11.1.0",
    "eslint-plugin-import": "^2.2.0",
    "istanbul": "^1.0.0-alpha.2",
    "mocha": "^2.5.3",
    "nodemon": "^1.9.1",
    "prompt-confirm": "^2.0.4",
    "sequelize-cli": "^2.4.0",
    "should": "^10.0.0",
    "should-sinon": "0.0.5",
    "sinon": "^2.1.0",
    "sinon-chai": "^2.9.0",
    "supertest": "^1.2.0"
  }
}
